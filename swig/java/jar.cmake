# Compile GEN/**/*.java and EXTRA/*.java into WORK and pack them as OUT
file(GLOB_RECURSE _files ${GEN}/*.java)
file(GLOB _extra ${EXTRA}/*.java)
list(APPEND _files ${_extra})
file(REMOVE_RECURSE ${WORK})
file(MAKE_DIRECTORY ${WORK})
set(_list "")
foreach(_f ${_files})
  string(APPEND _list "\"${_f}\"\n")
endforeach()
file(WRITE ${WORK}.sources "${_list}")
execute_process(COMMAND ${JAVAC} --release 11 -encoding UTF-8 -Xlint:all -d ${WORK} @${WORK}.sources
  RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "javac failed")
endif()
execute_process(COMMAND ${JAR} cf ${OUT} -C ${WORK} . RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "jar failed")
endif()
