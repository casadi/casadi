# Pack the shared libraries of DIR as a natives jar OUT for NativeLoader
#   cmake -DDIR=<install>/casadi -DPLATFORM=linux-x86_64 -DOUT=casadi-natives-linux-x86_64.jar -P natives.cmake
# Layout: org/casadi/natives/<PLATFORM>/{files.txt,<libs>}; files.txt lines are
#   file <sha256> <name>   or   link <name> <target>
foreach(_v DIR PLATFORM OUT)
  if(NOT ${_v})
    message(FATAL_ERROR "natives.cmake: ${_v} not set")
  endif()
endforeach()
get_filename_component(OUT ${OUT} ABSOLUTE)
set(_stage ${OUT}.stage)
set(_res ${_stage}/org/casadi/natives/${PLATFORM})
file(REMOVE_RECURSE ${_stage})
file(MAKE_DIRECTORY ${_res})
file(GLOB _libs LIST_DIRECTORIES false ${DIR}/*.so ${DIR}/*.so.* ${DIR}/*.dylib ${DIR}/*.dll)
list(SORT _libs)
set(_index "")
set(_found OFF)
foreach(_l ${_libs})
  get_filename_component(_n ${_l} NAME)
  if(_n MATCHES "^(lib)?casadi_java\\.")
    set(_found ON)
  endif()
  if(IS_SYMLINK ${_l})
    file(READ_SYMLINK ${_l} _t)
    get_filename_component(_t ${_t} NAME)
    string(APPEND _index "link ${_n} ${_t}\n")
  else()
    file(SHA256 ${_l} _h)
    file(COPY ${_l} DESTINATION ${_res})
    string(APPEND _index "file ${_h} ${_n}\n")
  endif()
endforeach()
if(NOT _found)
  message(FATAL_ERROR "natives.cmake: no casadi_java library in ${DIR}")
endif()
file(WRITE ${_res}/files.txt "${_index}")
file(REMOVE ${OUT})
execute_process(COMMAND ${CMAKE_COMMAND} -E tar cf ${OUT} --format=zip org WORKING_DIRECTORY ${_stage} RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "natives.cmake: packing ${OUT} failed")
endif()
file(REMOVE_RECURSE ${_stage})
