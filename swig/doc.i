  >>> a = Sparsity.diag(2)
  >>> b = Sparsity.triplet(2, 2, [0, 1], [1, 1])
  >>> DM(a.unite(b), 1)
  DM(
  [[1, 1],
   [00, 1]])
  >>> a + b == a.unite(b), a * b == a.intersect(b)
