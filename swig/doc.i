  >>> y = MX.sym(\"y\")
  >>> e = x*y + 1
  >>> e.n_dep(), e.dep(0), e.dep(1)
  (2, MX(1), MX((x*y)))
  >>> e.dep(1).dep(0), x.n_dep()
