%feature("docstring")  casadi::DaeBuilder::inputs(const std::string &cat)
const "

Input expressions for a specific category.

The symbolic expressions of the variables of an input category, in category
order.



Parameters:
    cat: One of ``\"t\"``, ``\"c\"``, ``\"p\"``, ``\"d\"``, ``\"w\"``, ``\"u\"``, ``\"x\"``, ``\"z\"``, ``\"q\"``; an output category such as ``\"ode\"`` is an error



Returns:
    List of (column vector) expressions, one per variable; empty when the category is empty



::

  >>> dae = DaeBuilder(\"m\")
  >>> x = dae.add(\"x\")
  >>> z = dae.add(\"z\")
  >>> u = dae.add(\"u\", \"input\")
  >>> dae.eq(dae.der(x), -x + z*u)
  >>> dae.eq(0, x - 2*z)
  >>> dae.inputs(\"x\"), dae.inputs(\"z\"), dae.inputs(\"u\"), dae.inputs(\"p\")
  ([MX(x)], [MX(z)], [MX(u)], [])
  >>> try:
  ...   dae.inputs(\"ode\")
  ... except Exception as e:
  ...   print(\"not an input category\" in str(e))
  True
  





See also: outputs, var, all

Extra doc: https://github.com/casadi/casadi/wiki/L_2fx

Doc source:
https://github.com/casadi/casadi/blob/main/casadi/core/dae_builder.hpp#L451
Implementation:
https://github.com/casadi/casadi/blob/main/casadi/core/dae_builder.cpp#L73-L80
";

%feature("docstring")  casadi::DaeBuilder::outputs(const std::string &cat)
const "

Output expressions for a specific category.

The defining expressions of an equation category, in the order of the
corresponding input category: ``\"ode\"`` (right-hand sides of the states
``x``), ``\"alg\"`` (residuals), ``\"quad\"`` (right-hand sides of ``q``),
``\"zero\"`` (zero-crossing functions of the when equations), ``\"ddef\"``
and ``\"wdef\"`` (binding expressions of ``d`` and ``w``), ``\"y\"``
(expressions of the outputs).



Parameters:
    cat: One of the output categories above; an input category is an error



Returns:
    List of expressions, empty when the category is empty



::

  >>> dae = DaeBuilder(\"m\")
  >>> x = dae.add(\"x\")
  >>> z = dae.add(\"z\")
  >>> u = dae.add(\"u\", \"input\")
  >>> dae.eq(dae.der(x), -x + z*u)
  >>> dae.eq(0, x - 2*z)
  >>> dae.outputs(\"ode\"), dae.outputs(\"alg\"), dae.outputs(\"y\")
  ([MX(((z*u)-x))], [MX((-(x-(2.*z))))], [])
  >>> try:
  ...   dae.outputs(\"x\")
  ... except Exception as e:
  ...   print(\"No input category\" in str(e))
  True
  





See also: inputs, wdef, ddef, create

Extra doc: https://github.com/casadi/casadi/wiki/L_2fy

Doc source:
https://github.com/casadi/casadi/blob/main/casadi/core/dae_builder.hpp#L495
Implementation:
https://github.com/casadi/casadi/blob/main/casadi/core/dae_builder.cpp#L82-L89
";

