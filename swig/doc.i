  [[1, 2],
   [4, 5]]), DM([3, 6])], [DM([[7, 8]]), DM(9)]]
  >>> blockcat(blocksplit(x, 2, 2))
  DM(
  [[1, 2, 3],
   [4, 5, 6],
   [7, 8, 9]])
  





See also: blockcat

