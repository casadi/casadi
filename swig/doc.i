  >>> knots = [[0, 0, 0, 0, 1, 2, 3, 3, 3, 3]]
  >>> B = MX.bspline_dual([0.5, 1.5], knots, [3])
  >>> B.shape, sum2(B)
  ((2, 6), DM([1, 1]))
  >>> B @ DM(range(6))
  DM([1.17708, 2.5])
  





