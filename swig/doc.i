  >>> import os, tempfile
  >>> C = conic(\"C\", \"qrqp\", {\"h\": Sparsity.dense(1)}, {\"print_header\": False})
  >>> d = tempfile.mkdtemp(); fn = os.path.join(d, \"C_debug.txt\")
  >>> try:
  ...     conic_debug(C, fn)
  ... except RuntimeError as e:
