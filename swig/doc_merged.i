  >>> S
  DM(
  [[0, 00, 00],
   [00, 5, 00],
   [00, 00, 6]])
  >>> S.nnz()
  3
  >>> try: S.nz[[0, 1]] = [1, 2, 3]
  ... except Exception as e: print(\"error\")
